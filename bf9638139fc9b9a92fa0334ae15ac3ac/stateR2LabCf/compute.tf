resource "cloudflare_workers_script" "r2lab-gateway" {
  account_id         = "bf9638139fc9b9a92fa0334ae15ac3ac"
  script_name        = "r2lab-gateway"
  compatibility_date = "2025-09-01"
  main_module        = "gateway.js"
  bindings = [
    {
      name = "GATEWAY_POLICY"
      text = jsonencode({ version = 2, caller = { cloud = "aws", role = "arn:aws:iam::952133486861:role/r2-lab-fn_role" }, resources = { (cloudflare_r2_bucket.r2-lab-phase3.name) = { kind = "r2", access = "write_no_delete", prefixes = ["lab/"], ttl_seconds = 30 } } })
      type = "plain_text"
    },
    {
      name = "R2_ACCOUNT_ID"
      text = "bf9638139fc9b9a92fa0334ae15ac3ac"
      type = "plain_text"
    },
    {
      name = "R2_PARENT_ACCESS_KEY_ID"
      text = cloudflare_account_token.r2lab-r2-parent.id
      type = "plain_text"
    },
    {
      name = "R2_PARENT_SECRET_ACCESS_KEY"
      text = sha256(cloudflare_account_token.r2lab-r2-parent.value)
      type = "secret_text"
    }
  ]
  content = (
    # Struct8 cross-cloud gateway v2.2.0
    # not a published release: built from the Struct8 source of v2.2.0
    # sha256: 77edc1fea926c7d2a192e05d543ad0b147be3c57f20c177d048719d975c0b0e1
    base64decode("")
  )
  observability = {
    enabled = true
    logs = {
      enabled            = true
      head_sampling_rate = 1
      invocation_logs    = true
    }
    traces = {
      enabled            = false
      head_sampling_rate = 1
    }
  }
}

resource "cloudflare_workers_script_subdomain" "r2lab-gateway" {
  account_id  = "bf9638139fc9b9a92fa0334ae15ac3ac"
  script_name = cloudflare_workers_script.r2lab-gateway.script_name
  enabled     = true
}
